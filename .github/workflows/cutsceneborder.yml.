name: Build CutsceneBorder
on:
  push:
  workflow_dispatch:
jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - name: Siapkan project
        run: |
          mkdir -p jni
          git clone --depth 1 https://github.com/RusJJ/AndroidModLoader.git aml
          cp -r aml/template_of_mod/mod jni/mod
          cat > jni/main.cpp << 'EOF'
          #include <mod/amlmod.h>
          #include <mod/logger.h>
          #include <mod/config.h>

          MYMODCFG(net.iqbal.cutsceneborder, Cutscene Border, 1.0, Iqbal)
          NEEDGAME(com.rockstargames.gtasa)

          // Susunan CRect di GTA SA: left, bottom, right, top
          struct CRect { float left, bottom, right, top; };
          struct CRGBA { uint8_t r, g, b, a; };

          static bool* pCutsceneRunning = nullptr;
          static void (*DrawRect)(const CRect&, const CRGBA&) = nullptr;

          // Tinggi garis hitam dalam persen dari tinggi layar (layar virtual game 640x448)
          static int g_barPercent = 12;

          DECL_HOOKv(Render2dStuff)
          {
              // Digambar sebelum 2D lain supaya subtitle tetap tampil di atas garis hitam
              if (pCutsceneRunning && *pCutsceneRunning && DrawRect)
              {
                  float h = 448.0f * (float)g_barPercent / 100.0f;
                  CRGBA black = { 0, 0, 0, 255 };

                  CRect topBar    = { -300.0f, h,            940.0f, -10.0f };
                  CRect bottomBar = { -300.0f, 458.0f, 940.0f, 448.0f - h };

                  DrawRect(topBar, black);
                  DrawRect(bottomBar, black);
              }
              Render2dStuff();
          }

          extern "C" void OnModLoad()
          {
              logger->SetTag("Cutscene Border");

              void* hGTASA = aml->GetLibHandle("libGTASA.so");
              if (!hGTASA)
              {
                  logger->Error("libGTASA.so tidak ditemukan");
                  return;
              }

              int v = cfg->Bind("BarHeightPercent", 12, "General")->GetInt();
              cfg->ClearLast();
              if (v < 0)  v = 0;
              if (v > 40) v = 40;
              g_barPercent = v;
              cfg->Save();

              pCutsceneRunning = (bool*)aml->GetSym(hGTASA, "_ZN12CCutsceneMgr10ms_runningE");
              if (!pCutsceneRunning)
              {
                  logger->Error("Simbol CCutsceneMgr::ms_running tidak ditemukan");
                  return;
              }

              DrawRect = (void (*)(const CRect&, const CRGBA&))aml->GetSym(hGTASA, "_ZN9CSprite2d8DrawRectERK5CRectRK5CRGBA");
              if (!DrawRect)
              {
                  logger->Error("Simbol CSprite2d::DrawRect tidak ditemukan");
                  return;
              }

              HOOKSYM(Render2dStuff, hGTASA, "_Z13Render2dStuffv");
              logger->Info("Aktif: garis hitam %d persen", g_barPercent);
          }
          EOF
          cat > jni/Android.mk << 'EOF'
          LOCAL_PATH := $(call my-dir)

          include $(CLEAR_VARS)
          LOCAL_CPP_EXTENSION := .cpp .cc
          LOCAL_MODULE    := CutsceneBorder
          LOCAL_SRC_FILES := main.cpp mod/logger.cpp mod/config.cpp
          LOCAL_CFLAGS += -O2 -DNDEBUG -std=c++17
          LOCAL_LDLIBS += -llog
          include $(BUILD_SHARED_LIBRARY)
          EOF
          cat > jni/Application.mk << 'EOF'
          APP_STL := c++_static
          APP_ABI := arm64-v8a
          APP_PLATFORM := android-24
          APP_OPTIM := release
          EOF
      - name: Build
        run: |
          "$ANDROID_NDK_ROOT/ndk-build" NDK_PROJECT_PATH=. APP_BUILD_SCRIPT=jni/Android.mk NDK_APPLICATION_MK=jni/Application.mk
      - uses: actions/upload-artifact@v4
        with:
          name: libCutsceneBorder
          path: libs/arm64-v8a/libCutsceneBorder.so
